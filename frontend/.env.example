# Local dev: use Vite proxy (/api → localhost:3001)
# Production (Vercel): set to your Render/Railway backend URL
VITE_API_URL=/api

# Asset base path — Vercel: leave unset or '/'. GitHub Pages: '/fraudshield-ai-platform/'
# VITE_BASE_PATH=/

# Enable API request logs in production (debug Overview blank screen)
# VITE_LOG_API=true
